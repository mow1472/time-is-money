<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Future Value Practice</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;0,800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#002E5D;
    --navy2:#0a3d70;
    --blue:#2f6feb;
    --yellow:#FFE600;
    --gold:#F2BA05;
    --amber-bg:#FFF9E0;
    --amber-border:#F3D77B;
    --amber-ink:#7a5c00;
    --green-bg:#E8F7EC;
    --green-border:#9EDBB0;
    --green-ink:#1a7a3c;
    --gray-bg:#F4F6F8;
    --lightblue-bg:#E9F4FC;
    --ink:#1a2733;
    --gray:#5a6470;
    --line:#dde3e9;
    --sans:'Open Sans', Arial, sans-serif;
    --mono:'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:var(--sans);
    background:#e9edf1;
    color:var(--ink);
    display:flex;
    justify-content:center;
    padding:40px 16px;
    min-height:100vh;
  }
  .wrap{ width:100%; max-width:600px; }

  .frame{
    background:#fff;
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 18px 40px -18px rgba(0,46,93,.55);
  }

  /* header bar */
  .bar{
    background:var(--navy);
    border-bottom:3px solid var(--yellow);
    padding:18px 26px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
  }
  .bar h1{
    color:#fff;
    font-size:18px;
    font-weight:800;
    letter-spacing:.2px;
  }
  .bar-right{
    display:flex;
    align-items:center;
    gap:14px;
  }
  .dots{
    display:flex;
    align-items:center;
    gap:7px;
  }
  .dot{
    width:8px; height:8px;
    border-radius:50%;
    background:rgba(255,255,255,.35);
  }
  .dot.active{
    width:12px; height:12px;
    background:var(--yellow);
    box-shadow:0 0 0 2px rgba(255,230,0,.35);
  }
  .dot.done{ background:var(--gold); }
  .q-pill{
    font-family:var(--mono);
    font-size:12px;
    font-weight:700;
    color:var(--navy);
    background:var(--yellow);
    padding:5px 12px;
    border-radius:20px;
    white-space:nowrap;
  }

  .body{ padding:28px 26px 26px; }

  .qrow{
    display:flex;
    gap:14px;
    margin-bottom:22px;
  }
  .qnum{
    flex-shrink:0;
    width:32px; height:32px;
    border-radius:50%;
    background:var(--navy);
    color:#fff;
    font-weight:800;
    font-size:14px;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .qtext{
    font-size:15.5px;
    line-height:1.6;
    color:var(--ink);
    padding-top:4px;
  }

  .answer-label{
    display:block;
    font-size:12.5px;
    font-weight:700;
    color:var(--gray);
    text-transform:uppercase;
    letter-spacing:.4px;
    margin-bottom:8px;
  }
  .answer-row{
    display:flex;
    gap:10px;
    margin-bottom:14px;
  }
  .answer-row input{
    flex:1;
    font-family:var(--mono);
    font-size:15px;
    padding:11px 14px;
    border:1.5px solid var(--line);
    border-radius:8px;
    outline:none;
    transition:border-color .15s;
  }
  .answer-row input:focus{ border-color:var(--blue); }
  .answer-row input:disabled{ background:var(--gray-bg); color:var(--gray); }

  button{ font-family:var(--sans); cursor:pointer; border:none; }
  .check-btn{
    background:var(--blue);
    color:#fff;
    font-weight:700;
    font-size:14px;
    padding:0 22px;
    border-radius:8px;
    transition:background .15s;
  }
  .check-btn:hover{ background:#2159c9; }
  .check-btn.hidden{ display:none; }

  .next-btn{
    background:var(--navy);
    color:#fff;
    font-weight:700;
    font-size:14px;
    padding:11px 22px;
    border-radius:8px;
    display:flex;
    align-items:center;
    gap:6px;
    transition:background .15s;
  }
  .next-btn:hover{ background:#001f42; }

  /* feedback callouts */
  .feedback{ margin-bottom:14px; }
  .callout{
    border-radius:8px;
    padding:12px 14px;
    display:flex;
    gap:10px;
    font-size:13px;
    line-height:1.55;
  }
  .callout .icon{
    flex-shrink:0;
    width:18px; height:18px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-size:11px;
    font-weight:800;
    margin-top:1px;
  }
  .callout.amber{ background:var(--amber-bg); border:1px solid var(--amber-border); color:var(--amber-ink); }
  .callout.amber .icon{ background:var(--gold); color:#5a4200; }
  .callout.green{ background:var(--green-bg); border:1px solid var(--green-border); color:var(--green-ink); }
  .callout.green .icon{ background:var(--green-ink); color:#fff; }
  .callout.gray{ background:var(--gray-bg); border:1px solid var(--line); color:var(--navy); }
  .callout.gray .icon{ background:var(--navy); color:#fff; }
  .callout b{ font-weight:800; }
  .callout .formula{ font-family:var(--mono); font-size:12px; color:var(--gray); margin-top:5px; }

  /* format note - chips */
  .format-note{
    background:var(--lightblue-bg);
    border-radius:10px;
    padding:16px 18px;
    display:flex;
    gap:14px;
    font-size:14px;
    line-height:1.7;
    color:var(--ink);
  }
  .format-note .icon{
    flex-shrink:0;
    width:26px; height:26px;
    border-radius:7px;
    background:var(--yellow);
    color:var(--navy);
    display:flex; align-items:center; justify-content:center;
    font-size:14px;
    font-weight:800;
    margin-top:1px;
  }
  .chip{
    font-family:var(--mono);
    background:#fff;
    border:1px solid #c9d3dc;
    border-radius:6px;
    padding:2px 8px;
    font-weight:600;
    font-size:13px;
  }

  .hidden{ display:none !important; }

  /* choice + finish screens */
  .choice, .finish{
    text-align:center;
    padding:20px 10px 10px;
  }
  .choice .badge, .finish .badge{
    width:56px; height:56px;
    border-radius:50%;
    background:var(--gray-bg);
    color:var(--navy);
    font-size:26px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 18px;
  }
  .choice h3, .finish h1{
    font-size:20px;
    font-weight:800;
    color:var(--navy);
    margin-bottom:10px;
  }
  .choice p, .finish p{
    font-size:14.5px;
    color:var(--gray);
    line-height:1.6;
    max-width:400px;
    margin:0 auto 26px;
  }
  .choice-buttons{
    display:flex;
    gap:12px;
    justify-content:center;
    flex-wrap:wrap;
  }
  .btn-outline{
    background:#fff;
    border:1.5px solid var(--line);
    color:var(--navy);
    font-weight:700;
    font-size:14px;
    padding:11px 22px;
    border-radius:8px;
    transition:background .15s;
  }
  .btn-outline:hover{ background:var(--gray-bg); }
  .btn-fill{
    background:var(--navy);
    color:#fff;
    font-weight:700;
    font-size:14px;
    padding:11px 22px;
    border-radius:8px;
    transition:background .15s;
  }
  .btn-fill:hover{ background:#001f42; }
</style>
</head>
<body>
<div class="wrap">
  <div class="frame">

    <div class="bar">
      <h1>Future Value Practice</h1>
      <div class="bar-right">
        <div class="dots" id="dots"></div>
        <span class="q-pill" id="qPill">Q1 of 5</span>
      </div>
    </div>

    <div class="body">

      <!-- QUIZ SCREEN -->
      <div id="quizScreen">
        <div class="qrow">
          <div class="qnum" id="qNum">1</div>
          <div class="qtext" id="questionText"></div>
        </div>

        <div id="answerForm">
          <label class="answer-label">Future value:</label>
          <div class="answer-row">
            <input type="text" id="userInput" placeholder="$0.00" autocomplete="off">
            <button type="button" class="check-btn" id="submitBtn" onclick="handleCheck()">Check</button>
          </div>

          <div class="feedback" id="feedback"></div>

          <div class="format-note" id="formatNote">
            <span class="icon">!</span>
            <span>Answers accepted: <span class="chip">$34,257.82</span>, <span class="chip">34,257.82</span>, or <span class="chip">34257.82</span> — the dollar sign and commas are optional.</span>
          </div>

          <div id="nextWrap" class="hidden" style="margin-top:16px;">
            <button type="button" class="next-btn" id="nextBtn" onclick="advanceToNextStep()">Next Problem →</button>
          </div>
        </div>
      </div>

      <!-- CHOICE SCREEN -->
      <div id="choiceScreen" class="choice hidden">
        <div class="badge">✓</div>
        <h3>Required Section Finished!</h3>
        <p>You've mastered the core concepts of Future Value. Would you like to finish now or tackle 3 more practice problems?</p>
        <div class="choice-buttons">
          <button class="btn-outline" id="finishNowBtn">Finish Now</button>
          <button class="btn-fill" id="continueBtn">Continue Practice →</button>
        </div>
      </div>

      <!-- FINISH SCREEN -->
      <div id="finishScreen" class="finish hidden">
        <div class="badge">📈</div>
        <h1>Module Complete!</h1>
        <p>Excellent work! You've mastered Future Value (FV) and the power of compounding growth over time.</p>
        <button class="next-btn" id="restartBtn" style="margin:0 auto;">↺ Restart Module</button>
      </div>

    </div>
  </div>
</div>

<script>
const questions = [
  {
    text: "You deposit $10,000 today into a savings account that earns 6% APR, compounded annually. How much will you have in 5 years?",
    answer: 13382.26,
    hint1: "Use the Future Value formula: FV = PV × (1 + r)^n.",
    hint2: "Calculation: 10,000 × (1.06)^5"
  },
  {
    text: "Suppose you invest $5,000 in a certificate of deposit (CD) with an annual interest rate of 4%. What will be the value of the investment after 10 years?",
    answer: 7401.22,
    hint1: "Remember, r is the interest rate (0.04) and n is the number of years (10).",
    hint2: "Calculation: 5,000 × (1.04)^10"
  },
  {
    text: "Practice: If you save $2,500 today at an 8% annual return, how much will you have in 15 years?",
    answer: 7930.42,
    hint1: "The exponent in your formula should be 15.",
    hint2: "Calculation: 2,500 × (1.08)^15"
  },
  {
    text: "Practice: You want to see the power of long-term growth. If you put $1,000 into an index fund averaging 7% APR, how much will it be worth in 40 years?",
    answer: 14974.46,
    hint1: "Compounding over 40 years makes a huge difference! Use n = 40.",
    hint2: "Calculation: 1,000 × (1.07)^40"
  },
  {
    text: "Practice: A piece of land costs $50,000 today and is expected to appreciate at 5% per year. What will it be worth in 12 years?",
    answer: 89792.82,
    hint1: "Treat the appreciation like an interest rate (r = 0.05).",
    hint2: "Calculation: 50,000 × (1.05)^12"
  }
];

let idx = 0;
let attempts = 0;
let status = 'idle';

const quizScreen = document.getElementById('quizScreen');
const choiceScreen = document.getElementById('choiceScreen');
const finishScreen = document.getElementById('finishScreen');
const qNum = document.getElementById('qNum');
const questionText = document.getElementById('questionText');
const userInput = document.getElementById('userInput');
const feedback = document.getElementById('feedback');
const submitBtn = document.getElementById('submitBtn');
const nextWrap = document.getElementById('nextWrap');
const qPill = document.getElementById('qPill');
const dotsEl = document.getElementById('dots');
const formatNote = document.getElementById('formatNote');

function renderDots(){
  dotsEl.innerHTML = '';
  for(let i=0;i<questions.length;i++){
    const d = document.createElement('div');
    d.className = 'dot' + (i === idx ? ' active' : (i < idx ? ' done' : ''));
    dotsEl.appendChild(d);
  }
}

function renderQuestion(){
  const q = questions[idx];
  qNum.textContent = idx+1;
  questionText.textContent = q.text;
  qPill.textContent = `Q${idx+1} of ${questions.length}`;
  renderDots();
  userInput.value = '';
  userInput.disabled = false;
  submitBtn.classList.remove('hidden');
  submitBtn.textContent = 'Check';
  nextWrap.classList.add('hidden');
  formatNote.classList.remove('hidden');
  feedback.innerHTML = '';
  attempts = 0;
  status = 'idle';
  userInput.focus();
}

function parseVal(raw){
  const cleaned = raw.replace(/[^0-9.]/g,'');
  return parseFloat(cleaned);
}

function handleCheck(){
  if(userInput.value.trim() === '') return;

  if(status === 'reveal-wait'){
    const q = questions[idx];
    const typed = parseVal(userInput.value);
    if(!isNaN(typed) && Math.abs(typed - q.answer) <= 0.01){
      advanceToNextStep();
    } else {
      const box = feedback.querySelector('.callout');
      if(box) box.querySelector('span:last-child').innerHTML = `<b>Not quite.</b> Type the exact answer shown above to continue.<div class="formula">FV = PV × (1 + r)^n</div>`;
    }
    return;
  }

  if(status === 'correct') return;

  const val = parseVal(userInput.value);
  if(isNaN(val)) return;
  const q = questions[idx];

  if(Math.abs(val - q.answer) <= 0.1){
    status = 'correct';
    userInput.disabled = true;
    feedback.innerHTML = `
      <div class="callout green">
        <span class="icon">✓</span>
        <span><b>Correct!</b> Your calculation is within the accepted rounding margin.</span>
      </div>`;
    submitBtn.classList.add('hidden');
    nextWrap.classList.remove('hidden');
  } else {
    attempts++;
    if(attempts >= 3){
      status = 'reveal-wait';
      const fmtAnswer = q.answer.toLocaleString(undefined,{minimumFractionDigits:2, maximumFractionDigits:2});
      feedback.innerHTML = `
        <div class="callout gray">
          <span class="icon">i</span>
          <span><b>The answer is $${fmtAnswer}.</b>
          <div class="formula">FV = PV × (1 + r)^n</div>
          <div style="margin-top:6px; font-weight:700; color:var(--navy);">Type this amount above and select Check to continue.</div></span>
        </div>`;
      userInput.value = '';
      userInput.focus();
    } else {
      status = 'wrong';
      const hint = attempts === 1 ? q.hint1 : q.hint2;
      feedback.innerHTML = `
        <div class="callout amber">
          <span class="icon">!</span>
          <span><b>Not quite right.</b> (Attempt ${attempts}/3)
          <div style="margin-top:4px; font-style:italic;">Hint: ${hint}</div></span>
        </div>`;
    }
  }
}

userInput.addEventListener('keydown', (e) => {
  if(e.key === 'Enter'){
    e.preventDefault();
    handleCheck();
  }
});

function advanceToNextStep(){
  if(idx === 1){
    quizScreen.classList.add('hidden');
    choiceScreen.classList.remove('hidden');
    return;
  }
  if(idx < questions.length - 1){
    idx++;
    renderQuestion();
  } else {
    showFinish();
  }
}

document.getElementById('finishNowBtn').addEventListener('click', showFinish);
document.getElementById('continueBtn').addEventListener('click', () => {
  choiceScreen.classList.add('hidden');
  quizScreen.classList.remove('hidden');
  idx = 2;
  renderQuestion();
});

function showFinish(){
  quizScreen.classList.add('hidden');
  choiceScreen.classList.add('hidden');
  finishScreen.classList.remove('hidden');
  qPill.textContent = 'Complete';
  dotsEl.innerHTML = '';
  for(let i=0;i<questions.length;i++){
    const d = document.createElement('div');
    d.className = 'dot done';
    dotsEl.appendChild(d);
  }
}

document.getElementById('restartBtn').addEventListener('click', () => {
  idx = 0;
  finishScreen.classList.add('hidden');
  quizScreen.classList.remove('hidden');
  renderQuestion();
});

renderQuestion();
</script>
</body>
</html>
